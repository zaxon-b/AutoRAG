# Infrastructure
TIMEZONE=Asia/Shanghai
MEM_LIMIT=2147483648
ELASTIC_PASSWORD=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@gsk_pg:5432/gsk
ELASTICSEARCH_URL=http://es01:9200
ES_HOST=http://es01:9200
MANUAL_INDEX_NAME=manual_chunks_demo
DEMO_MANUAL_ID=demo_manual
ROOT_PATH=

# Text answer LLM, OpenAI-compatible.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Text embedding, OpenAI-compatible DashScope endpoint.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# Text reranker used after RRF candidate fusion.
TEXT_RERANK_MODEL=qwen3-rerank
TEXT_RERANK_MAX_CHARS=1200

# Vision-language model for image understanding and candidate verification.
VLM_API_KEY=
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen-vl-plus
# First-pass image_type/confidence are metadata only. This threshold applies
# only to the second-pass candidate-image verification.
VLM_VISUAL_VERIFICATION_THRESHOLD=0.75
# 图像向量只负责建立候选池；低于该 0-100 分数的强制近邻不会进入 VLM。
MIN_IMAGE_EMBEDDING_CANDIDATE_SCORE=50

# Image embedding for image-to-manual visual chunk retrieval.
IMAGE_EMBEDDING_MODEL=tongyi-embedding-vision-flash
IMAGE_EMBEDDING_DIM=768
IMAGE_EMBEDDING_BATCH_SIZE=10
IMAGE_EMBEDDING_MAX_RETRIES=3

# Shared image/text embedding used for cross-modal retrieval. The API accepts
# at most 20 text items and one image per request; the service enforces both.
MULTIMODAL_EMBEDDING_MODEL=multimodal-embedding-v1
MULTIMODAL_EMBEDDING_DIM=1024
MULTIMODAL_EMBEDDING_TEXT_BATCH_SIZE=20
MULTIMODAL_EMBEDDING_TEXT_MAX_CHARS=500
MULTIMODAL_EMBEDDING_MAX_RETRIES=3
MULTIMODAL_EMBEDDING_IMAGE_WORKERS=1

# Bookmark-tree text chunks and recursive parent merging.
MANUAL_TEXT_LEAF_TOKEN_LIMIT=500
AUTO_MERGE_MIN_MATCHED_CHILDREN=2
AUTO_MERGE_MIN_CHILD_RATIO=0.5
AUTO_MERGE_MAX_PARENT_TOKENS=1800
AUTO_MERGE_MAX_EVIDENCE_TOKENS=5000

# Visual extraction, occurrence content and icon grouping.
MANUAL_ICON_EXTRACTION_ENABLED=true
MANUAL_ICON_MAX_PER_PAGE=64
MANUAL_ICON_NAME_VLM_ENABLED=true
VISUAL_ICON_NAME_BATCH_SIZE=1
VISUAL_OPERATION_NAME_BATCH_SIZE=4
VISUAL_OBJECT_NAME_WORKERS=3
OPERATION_OBJECT_NAME_MAX_CHARS=40
MANUAL_VISUAL_CONTENT_TOKEN_LIMIT=1400
ICON_GROUP_PHASH_DISTANCE=10
ICON_GROUP_EXACT_PHASH_DISTANCE=3
ICON_GROUP_VECTOR_SIMILARITY=0.88
ICON_GROUP_MAX_NEIGHBOURS=5
ICON_GROUP_VLM_CONFIDENCE=0.82
ICON_GROUP_VLM_MAX_ITEMS=36
